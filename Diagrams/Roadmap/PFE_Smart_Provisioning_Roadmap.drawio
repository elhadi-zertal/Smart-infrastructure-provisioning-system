        <mxCell id="302" parent="300" style="text;html=1;strokeColor=#B09500;fillColor=#e3c800;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;🖥️ Proxmox Advanced&lt;/b&gt;&lt;br&gt;• Cluster management&lt;br&gt;• VM/LXC lifecycle &amp;amp; API&lt;br&gt;• Storage: ZFS, LVM&lt;br&gt;• SDN: Bridges, VLANs&lt;br&gt;• VXLAN zones&lt;br&gt;• API token auth&lt;br&gt;• Backup &amp;amp; snapshots&lt;br&gt;• HA Manager&lt;br&gt;• proxmoxer Python lib&lt;br&gt;• ProxmoxAPI client" vertex="1">
          <mxGeometry height="185" width="270" x="10" y="94" as="geometry" />
        </mxCell>
        <mxCell id="303" parent="300" style="text;html=1;strokeColor=#B09500;fillColor=#e3c800;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;⚙️ Kubernetes Advanced&lt;/b&gt;&lt;br&gt;• kubeadm cluster setup&lt;br&gt;• RBAC &amp;amp; namespaces&lt;br&gt;• Persistent Volumes (PVC)&lt;br&gt;• ConfigMaps / Secrets&lt;br&gt;• kubectl &amp;amp; kubeconfig&lt;br&gt;• HPA / replica scaling&lt;br&gt;• K8s Python client&lt;br&gt;• Deployment patching API&lt;br&gt;• AppsV1Api / CoreV1Api" vertex="1">
          <mxGeometry height="175" width="270" x="10" y="289" as="geometry" />
        </mxCell>
        <mxCell id="304" parent="300" style="text;html=1;strokeColor=#B09500;fillColor=#e3c800;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;🐳 Docker Advanced&lt;/b&gt;&lt;br&gt;• Multi-stage builds&lt;br&gt;• Docker networking modes&lt;br&gt;• Registry &amp;amp; image mgmt&lt;br&gt;• Resource limits&lt;br&gt;• Docker in Proxmox VMs&lt;br&gt;• Container security&lt;br&gt;• docker-compose &amp;amp; stacks" vertex="1">
          <mxGeometry height="145" width="270" x="10" y="474" as="geometry" />
        </mxCell>
        <mxCell id="400" parent="1" style="swimlane;startSize=50;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;fontColor=#5c2800;swimlaneLine=1;rounded=1;arcSize=3;" value="PHASE 2 — INFRASTRUCTURE (Proxmox + K8s)📅 February – March 2026 | Currently Ongoing" vertex="1">
          <mxGeometry height="1980" width="550" x="1520" y="83" as="geometry" />
        </mxCell>
        <mxCell id="401" parent="400" style="text;html=1;strokeColor=none;fillColor=#7a3300;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🖥️ Physical Hardware Setup&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="530" x="10" y="58" as="geometry" />
        </mxCell>
        <mxCell id="402" parent="400" style="text;html=1;strokeColor=#B20000;fillColor=#e51400;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="16 Physical PCs → &lt;b&gt;Proxmox VE installed on all 16&lt;/b&gt;&lt;br&gt;→ Proxmox Cluster formed → &lt;b&gt;8 Physical Machines (PMs) joined as cluster nodes&lt;/b&gt;&lt;br&gt;(Remaining 8 kept as standby / test machines)" vertex="1">
          <mxGeometry height="54" width="530" x="10" y="94" as="geometry" />
        </mxCell>
        <mxCell id="403" parent="400" style="text;html=1;strokeColor=none;fillColor=#7a3300;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🚀 VM Deployment — Hybrid HA Approach&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="530" x="10" y="158" as="geometry" />
        </mxCell>
        <mxCell id="404" parent="400" style="text;html=1;strokeColor=#B20000;fillColor=#e51400;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;Initial VM Sizing:&lt;/b&gt; 3 GB RAM | 1 vCPU | 25 GB Disk&lt;br&gt;&lt;br&gt;&lt;b&gt;Ministry VMs (VLAN 2 — 10.20.20.0/24):&lt;/b&gt;&lt;br&gt;  Soin ×2 | Notifications ×2&lt;br&gt;&lt;br&gt;&lt;b&gt;Hospital VMs (VLAN 1 — 10.10.10.0/24):&lt;/b&gt;&lt;br&gt;  Frontend ×2 | Reception ×2 | Medicament ×2&lt;br&gt;&lt;br&gt;Total: 10 app VMs + 1 Monitoring VM + 1 OPNsense VM" vertex="1">
          <mxGeometry height="130" width="530" x="10" y="194" as="geometry" />
        </mxCell>
        <mxCell id="405" parent="400" style="text;html=1;strokeColor=#B20000;fillColor=#e51400;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontStyle=1;fontColor=#ffffff;" value="&lt;b&gt;🔷 Mini-Clusters Architecture (New Idea)&lt;/b&gt;&lt;br&gt;Divide full cluster into k mini-clusters:&lt;br&gt;• Optimizes provisioning algorithm: O(n) → O(n/k)&lt;br&gt;• Organizes VM scaling and new VM creation&lt;br&gt;• New cloned VM joins the same mini-cluster as its parent&lt;br&gt;• Enables localized horizontal scaling decisions" vertex="1">
          <mxGeometry height="96" width="530" x="10" y="334" as="geometry" />
        </mxCell>
        <mxCell id="406" parent="400" style="text;html=1;strokeColor=#B20000;fillColor=#e51400;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;📊 Monitoring VM (VLAN 3 — 10.30.30.0/24)&lt;/b&gt;&lt;br&gt;• Prometheus — metrics scraping (node_exporter on every VM)&lt;br&gt;• Loki — log aggregation&lt;br&gt;• Grafana — dashboards &amp;amp; visualization&lt;br&gt;• Alertmanager — sends webhooks to AlterManager API&lt;br&gt;• blackbox_exporter — HTTP 5xx rate monitoring" vertex="1">
          <mxGeometry height="100" width="530" x="10" y="440" as="geometry" />
        </mxCell>
        <mxCell id="410" parent="400" style="text;html=1;strokeColor=none;fillColor=#7a3300;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🌐 VIRTUAL NETWORK ARCHITECTURE&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="530" x="10" y="550" as="geometry" />
        </mxCell>
        <mxCell id="411" parent="400" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#333333;" value="&lt;b&gt;Physical Network:&lt;/b&gt; 172.25.5.0/24&lt;br&gt;All 16 PMs + Router on this physical LAN&lt;br&gt;Physical switch is &lt;b&gt;UNMANAGED&lt;/b&gt; (no VLAN tagging support)" vertex="1">
          <mxGeometry height="56" width="530" x="10" y="586" as="geometry" />
        </mxCell>
        <mxCell id="412" parent="400" style="text;html=1;strokeColor=#C73500;fillColor=#fa6800;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;🛡️ OPNsense VM — Virtual Router/Firewall&lt;/b&gt;&lt;br&gt;Acts as vRouter bridging physical LAN (172.25.5.0/24) to virtual networks&lt;br&gt;Provides routing, firewall rules, and VLAN separation&lt;br&gt;Connected to all 3 VLANs + physical uplink" vertex="1">
          <mxGeometry height="72" width="530" x="10" y="652" as="geometry" />
        </mxCell>
        <mxCell id="413" parent="400" style="text;html=1;strokeColor=#BD7000;fillColor=#f0a30a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;VLAN 1 — Hospital&lt;/b&gt;&lt;br&gt;10.10.10.0/24&lt;br&gt;Frontend, Reception,&lt;br&gt;Medicament VMs" vertex="1">
          <mxGeometry height="75" width="168" x="10" y="734" as="geometry" />
        </mxCell>
        <mxCell id="414" parent="400" style="text;html=1;strokeColor=#BD7000;fillColor=#f0a30a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;VLAN 2 — Ministry&lt;/b&gt;&lt;br&gt;10.20.20.0/24&lt;br&gt;Soin, Notifications&lt;br&gt;VMs" vertex="1">
          <mxGeometry height="75" width="168" x="188" y="734" as="geometry" />
        </mxCell>
        <mxCell id="415" parent="400" style="text;html=1;strokeColor=#BD7000;fillColor=#f0a30a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#000000;" value="&lt;b&gt;VLAN 3 — Monitoring&lt;/b&gt;&lt;br&gt;10.30.30.0/24&lt;br&gt;Prometheus, Grafana&lt;br&gt;Loki, Alertmanager" vertex="1">
          <mxGeometry height="75" width="164" x="366" y="734" as="geometry" />
        </mxCell>
        <mxCell id="416" parent="400" style="text;html=1;strokeColor=#B09500;fillColor=#e3c800;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontStyle=2;fontColor=#000000;" value="🔗 &lt;b&gt;VXLAN SDN Zones (Proxmox)&lt;/b&gt; — Software-Defined Networking&lt;br&gt;Enables virtual L2 segments over unmanaged physical switch (L3 tunnel encapsulation)&lt;br&gt;Workaround for non-manageable physical switch" vertex="1">
          <mxGeometry height="50" width="530" x="10" y="819" as="geometry" />
        </mxCell>
        <mxCell id="500" parent="1" style="swimlane;startSize=50;fillColor=#76608a;strokeColor=#432D57;fontStyle=1;fontSize=12;fontColor=#ffffff;swimlaneLine=1;rounded=1;arcSize=3;" value="PHASE 2 — ALTERMANAGER API 📅 Feb–Mar 2026" vertex="1">
          <mxGeometry height="1980" width="660" x="2080" y="83" as="geometry" />
        </mxCell>
        <mxCell id="501" parent="500" style="text;html=1;strokeColor=none;fillColor=#4a0080;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;⚙️ System Flow&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="640" x="10" y="58" as="geometry" />
        </mxCell>
        <mxCell id="502" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="Prometheus &lt;b&gt;Alertmanager&lt;/b&gt; → webhook → &lt;b&gt;AlterManager API&lt;/b&gt; → &lt;b&gt;Proxmox API&lt;/b&gt; (VMs/LXC) or &lt;b&gt;Kubernetes API&lt;/b&gt;&lt;br&gt;Scheduler: cluster poll every &lt;b&gt;10s&lt;/b&gt; | warning queue process every &lt;b&gt;30s&lt;/b&gt; (max 1 instance each)" vertex="1">
          <mxGeometry height="44" width="640" x="10" y="94" as="geometry" />
        </mxCell>
        <mxCell id="503" parent="500" style="text;html=1;strokeColor=none;fillColor=#4a0080;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;📨 Alert Label Schema (from Prometheus alerts.yml)&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="640" x="10" y="148" as="geometry" />
        </mxCell>
        <mxCell id="504" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontFamily=Courier New;fontColor=#ffffff;" value="target_type : &quot;vm&quot; | &quot;lxc&quot; | &quot;k8s&quot;&lt;br&gt;severity    : &quot;warning&quot; | &quot;critical&quot;&lt;br&gt;type        : &quot;cpu&quot; | &quot;memory&quot; | &quot;disk_io&quot; | &quot;network&quot; | &quot;http_5xx&quot;&lt;br&gt;vmid        : &quot;152&quot;   (Proxmox VM/LXC ID)&lt;br&gt;namespace   : &quot;default&quot; + deployment: &quot;my-app&quot;  (K8s only)" vertex="1">
          <mxGeometry height="80" width="640" x="10" y="184" as="geometry" />
        </mxCell>
        <mxCell id="510" parent="500" style="text;html=1;strokeColor=none;fillColor=#4a0080;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🚨 Alert Thresholds &amp;amp; Auto-Scaling Rules&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="640" x="10" y="274" as="geometry" />
        </mxCell>
        <mxCell id="511" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;CPU Usage&lt;/b&gt;&lt;br&gt;⚠️ &gt; 80% → WARNING → queue&lt;br&gt;🔴 &gt; 95% → CRITICAL → &lt;b&gt;+1 vCPU&lt;/b&gt; (vertical)" vertex="1">
          <mxGeometry height="68" width="310" x="10" y="310" as="geometry" />
        </mxCell>
        <mxCell id="512" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;RAM Usage&lt;/b&gt;&lt;br&gt;⚠️ &gt; 60% → WARNING → queue&lt;br&gt;🔴 &gt; 80% → CRITICAL → &lt;b&gt;+20% RAM&lt;/b&gt; (vertical)" vertex="1">
          <mxGeometry height="68" width="320" x="330" y="310" as="geometry" />
        </mxCell>
        <mxCell id="513" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;Disk I/O (Free)&lt;/b&gt;&lt;br&gt;⚠️ Free &lt; 20% → WARNING → queue&lt;br&gt;🔴 Free &lt; 20% → CRITICAL → &lt;b&gt;+15G disk&lt;/b&gt; (vertical)" vertex="1">
          <mxGeometry height="68" width="310" x="10" y="388" as="geometry" />
        </mxCell>
        <mxCell id="514" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;Network / HTTP Errors&lt;/b&gt;&lt;br&gt;⚠️ HTTP 5xx &gt; 1% → WARNING → queue&lt;br&gt;🔴 HTTP 5xx &gt; 5% → CRITICAL → &lt;b&gt;clone VM&lt;/b&gt; (horizontal)&lt;br&gt;🔴 Packet Loss &gt; 2% → CRITICAL → &lt;b&gt;clone VM&lt;/b&gt; (horizontal)" vertex="1">
          <mxGeometry height="68" width="320" x="330" y="388" as="geometry" />
        </mxCell>
        <mxCell id="520" parent="500" style="text;html=1;strokeColor=none;fillColor=#4a0080;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;⚡ Scaling Decision Logic&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="640" x="10" y="466" as="geometry" />
        </mxCell>
        <mxCell id="521" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="⚠️ &lt;b&gt;WARNING Path&lt;/b&gt;&lt;br&gt;→ Add to warning_queue (one entry per VM, multi-alert)&lt;br&gt;→ Processed by DE-WOA on next 30s scheduler tick&lt;br&gt;→ Pre-emptive / proactive scaling&lt;br&gt;→ Multiple alert types merged per VM (CPU+RAM = 1 entry)" vertex="1">
          <mxGeometry height="88" width="310" x="10" y="502" as="geometry" />
        </mxCell>
        <mxCell id="522" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="🔴 &lt;b&gt;CRITICAL Path — Immediate Action&lt;/b&gt;&lt;br&gt;CPU | MEMORY | DISK_IO → &lt;b&gt;Vertical Scale&lt;/b&gt; now&lt;br&gt;NETWORK | HTTP_5XX → &lt;b&gt;Horizontal Scale&lt;/b&gt; now&lt;br&gt;PM resources insufficient → &lt;b&gt;Migrate VM&lt;/b&gt; (calls DE-WOA)&lt;br&gt;Energy cap exceeded → reject, log warning" vertex="1">
          <mxGeometry height="88" width="320" x="330" y="502" as="geometry" />
        </mxCell>
        <mxCell id="523" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;Scaling Actions Detail:&lt;/b&gt;&lt;br&gt;Proxmox Vertical: +1 vCPU | +20% RAM (MB) | +15G disk (in-place config PUT, zero downtime for CPU/RAM)&lt;br&gt;Proxmox Horizontal: clone VM/LXC (full=1) → assign new VMID → start clone → joins parent mini-cluster&lt;br&gt;K8s Vertical: CPU +200 millicores | Memory +20% (patch deployment limits &amp;amp; requests)&lt;br&gt;K8s Horizontal: +1 replica (patch deployment scale)" vertex="1">
          <mxGeometry height="80" width="640" x="10" y="600" as="geometry" />
        </mxCell>
        <mxCell id="530" parent="500" style="text;html=1;strokeColor=none;fillColor=#4a0080;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;📐 FITNESS FUNCTION — VM Placement Score&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="640" x="10" y="690" as="geometry" />
        </mxCell>
        <mxCell id="531" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontFamily=Courier New;fontColor=#ffffff;" value="fitness = √( w₁·(ΔC*)² + w₂·(ΔR*)² + w₃·(ΔIO*)² + w₄·(ΔE*)² )&lt;br&gt;&lt;br&gt;ΔX  = resource_needed_by_VM − resource_available_on_node&lt;br&gt;ΔX* = (ΔX − mean_ΔX) / σ_ΔX  ← z-score normalization&lt;br&gt;&lt;br&gt;Weights: W_CPU=0.35 | W_RAM=0.35 | W_IO=0.15 | W_E=0.15&lt;br&gt;&lt;br&gt;Infeasible node (any ΔX &gt; 0) → returns infinity (rejected)&lt;br&gt;σ source: rolling history window (500 samples) preferred;&lt;br&gt;fallback to cross-sectional σ during warm-up (&lt;30 samples)&lt;br&gt;&lt;br&gt;Energy model: 50W per CPU core | 10W per GB RAM&lt;br&gt;Real data from Prometheus preferred over Proxmox API estimates" vertex="1">
          <mxGeometry height="165" width="640" x="10" y="726" as="geometry" />
        </mxCell>
        <mxCell id="540" parent="500" style="text;html=1;strokeColor=none;fillColor=#4a0080;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🐋 HYBRID DE-WOA PROVISIONING ALGORITHM&lt;/b&gt;&lt;br&gt;Differential Evolution + Whale Optimization Algorithm (adapted)" vertex="1">
          <mxGeometry height="36" width="640" x="10" y="901" as="geometry" />
        </mxCell>
        <mxCell id="541" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="1. Randomly sample &lt;b&gt;m PMs&lt;/b&gt; from n available online nodes&lt;br&gt;2. Map &lt;b&gt;m VMs&lt;/b&gt; to m sampled PMs (random permutation)&lt;br&gt;3. Calculate &lt;b&gt;total fitness&lt;/b&gt; = Σ fitness(vm_i, node_i)&lt;br&gt;4. Remap &lt;b&gt;k1=10 times&lt;/b&gt; → keep mapping with lowest fitness&lt;br&gt;5. Take a &lt;b&gt;different random sample&lt;/b&gt; of m PMs&lt;br&gt;6. Repeat steps 1-4 with new sample&lt;br&gt;7. Repeat steps 5-6 for &lt;b&gt;k2=5 independent samples&lt;/b&gt;&lt;br&gt;8. Return mapping with best overall fitness across all k2 samples&lt;br&gt;&lt;br&gt;→ Container → VM assignment: &lt;b&gt;Best Fit algorithm&lt;/b&gt;&lt;br&gt;→ Migration suggestion logged if better node found (manual action)" vertex="1">
          <mxGeometry height="165" width="640" x="10" y="947" as="geometry" />
        </mxCell>
        <mxCell id="550" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;📡 Prometheus Metrics Integration (Optional Enhancement)&lt;/b&gt;&lt;br&gt;4 real-time per-VM metrics fetched in parallel (ThreadPoolExecutor):&lt;br&gt;cpu_actual (cores in use) | ram_actual (bytes) | io_actual (bytes/s) | energy_actual (watts)&lt;br&gt;Queries configurable via env vars | Falls back to Proxmox API estimates if unavailable&lt;br&gt;Node IO capacity configurable: NODE_IO_CAPACITY_BPS (default 500 MB/s SATA SSD)" vertex="1">
          <mxGeometry height="80" width="640" x="10" y="1122" as="geometry" />
        </mxCell>
        <mxCell id="560" parent="500" style="text;html=1;strokeColor=#432D57;fillColor=#76608a;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;🔌 REST API Endpoints&lt;/b&gt;&lt;br&gt;POST /alertmanager/webhook — Receive Prometheus Alertmanager webhooks&lt;br&gt;GET  /health — Health check + queue size + delta history stats&lt;br&gt;GET  /nodes | /vms | /lxc | /deployments — Live cluster state&lt;br&gt;PUT  /vms/{vmid}/resources — Manual vertical scale (VM)&lt;br&gt;PUT  /lxc/{vmid}/resources — Manual vertical scale (LXC)&lt;br&gt;POST /vms/{vmid}/clone — Manual horizontal scale (VM)&lt;br&gt;POST /lxc/{vmid}/clone — Manual horizontal scale (LXC)&lt;br&gt;PATCH /deployments/{ns}/{dep}/replicas — K8s manual replica set&lt;br&gt;GET  /warning-queue — View pending DE-WOA items&lt;br&gt;DELETE /warning-queue/{id} — Remove item or specific alert type&lt;br&gt;GET  /delta-history/stats — Fitness normalization diagnostics" vertex="1">
          <mxGeometry height="155" width="640" x="10" y="1212" as="geometry" />
        </mxCell>
        <mxCell id="600" parent="1" style="swimlane;startSize=50;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#5c0000;swimlaneLine=1;rounded=1;arcSize=3;" value="PHASE 3 — AI INTEGRATION &amp;amp; AUTOMATION📅 April – June 2026" vertex="1">
          <mxGeometry height="1983" width="435" x="2755" y="80" as="geometry" />
        </mxCell>
        <mxCell id="601" parent="600" style="text;html=1;strokeColor=none;fillColor=#990000;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🔬 Phase 2 Testing &amp;amp; Improvement&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="420" x="10" y="58" as="geometry" />
        </mxCell>
        <mxCell id="602" parent="600" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;gradientColor=#ea6b66;" value="• Stress tests on Proxmox infrastructure&lt;br&gt;• Validate AlterManager scaling reactions&lt;br&gt;• Tune thresholds &amp;amp; DE-WOA parameters&lt;br&gt;• Validate fitness function accuracy&lt;br&gt;• Measure energy consumption&lt;br&gt;• Network performance benchmarks&lt;br&gt;• Compare downtime before vs. after&lt;br&gt;• Measure provisioning response time" vertex="1">
          <mxGeometry height="140" width="420" x="10" y="94" as="geometry" />
        </mxCell>
        <mxCell id="603" parent="600" style="text;html=1;strokeColor=none;fillColor=#990000;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;rounded=1;" value="&lt;b&gt;🤖 AI Integration (Planned)&lt;/b&gt;" vertex="1">
