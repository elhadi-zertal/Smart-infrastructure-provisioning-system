        </mxCell>
        <mxCell id="202" parent="200" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="🖥️ &lt;b&gt;16 Physical Machines&lt;/b&gt; → Ubuntu Server installed on all 16&lt;br&gt;Test approach: deploy cluster → stress test → scale → improve → next cluster" vertex="1">
          <mxGeometry height="42" width="440" x="10" y="106" as="geometry" />
        </mxCell>
        <mxCell id="210" parent="200" style="text;html=1;strokeColor=none;fillColor=#0050ef;fontColor=#ffffff;align=center;fontStyle=1;rounded=1;" value="&lt;b&gt;🔵 CLUSTER 1 — Basic&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="440" x="10" y="160" as="geometry" />
        </mxCell>
        <mxCell id="211" parent="200" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="• 1 Ministry node + 1 Hospital node&lt;br&gt;• No scaling, no redundancy&lt;br&gt;• Single node fails → entire service goes DOWN&lt;br&gt;• Purpose: Baseline prototype / testing environment" vertex="1">
          <mxGeometry height="68" width="440" x="10" y="196" as="geometry" />
        </mxCell>
        <mxCell id="220" parent="200" style="text;html=1;strokeColor=none;fillColor=#b8860b;fontColor=#ffffff;align=center;fontStyle=1;rounded=1;" value="&lt;b&gt;🟡 CLUSTER 2 — Scaled&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="440" x="10" y="276" as="geometry" />
        </mxCell>
        <mxCell id="221" parent="200" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="• Ministry server: &lt;b&gt;2 replicas&lt;/b&gt;&lt;br&gt;• Hospital server: &lt;b&gt;3 replicas&lt;/b&gt;&lt;br&gt;• 1 replica fails → others continue serving requests&lt;br&gt;• Purpose: Handle more traffic + basic fault tolerance" vertex="1">
          <mxGeometry height="68" width="440" x="10" y="312" as="geometry" />
        </mxCell>
        <mxCell id="230" parent="200" style="text;html=1;strokeColor=none;fillColor=#c85000;fontColor=#ffffff;align=center;fontStyle=1;rounded=1;" value="&lt;b&gt;🟠 CLUSTER 3 — Microservices&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="440" x="10" y="392" as="geometry" />
        </mxCell>
        <mxCell id="231" parent="200" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;Ministry:&lt;/b&gt; Soin | Notifications&lt;br&gt;&lt;b&gt;Hospital:&lt;/b&gt; Frontend | Reception | Medicament&lt;br&gt;• Each service runs independently&lt;br&gt;• Purpose: Modularity, maintainability, independent scaling" vertex="1">
          <mxGeometry height="68" width="440" x="10" y="428" as="geometry" />
        </mxCell>
        <mxCell id="240" parent="200" style="text;html=1;strokeColor=none;fillColor=#1a7a1a;fontColor=#ffffff;align=center;fontStyle=1;rounded=1;" value="&lt;b&gt;🟢 CLUSTER 4 — Hybrid HA (High Availability)&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="440" x="10" y="508" as="geometry" />
        </mxCell>
        <mxCell id="241" parent="200" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="Microservices + Replicas (×2 per service):&lt;br&gt;• Soin ×2 | Notifications ×2&lt;br&gt;• Frontend ×2 | Reception ×2 | Medicament ×2&lt;br&gt;&lt;br&gt;Container crash → another replica takes over automatically&lt;br&gt;Purpose: &lt;b&gt;Production-grade HA + Fault Tolerance + Scalability&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="440" x="10" y="544" as="geometry" />
        </mxCell>
        <mxCell id="250" parent="200" style="text;html=1;strokeColor=#2D7600;fillColor=#60a917;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;b&gt;📈 Stress Tests + PLG Monitoring Results&lt;/b&gt;&lt;br&gt;Applied to all 4 clusters — measured: CPU usage, RAM, network throughput,&lt;br&gt;HTTP response times, uptime, error rates, recovery time" vertex="1">
          <mxGeometry height="65" width="440" x="10" y="646" as="geometry" />
        </mxCell>
        <mxCell id="251" parent="200" style="text;html=1;strokeColor=#1a7a1a;fillColor=#1a7a1a;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;rounded=1;" value="🏆 RESULT: &lt;b&gt;Hybrid HA (Cluster 4) = Best Architecture&lt;/b&gt;&lt;br&gt;Selected as the deployment strategy for Phase 2" vertex="1">
          <mxGeometry height="42" width="440" x="10" y="721" as="geometry" />
