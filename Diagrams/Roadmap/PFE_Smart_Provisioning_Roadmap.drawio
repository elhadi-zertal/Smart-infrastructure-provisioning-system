        <mxCell id="110" parent="100" style="text;html=1;strokeColor=none;fillColor=#003d99;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;rounded=1;" value="&lt;b&gt;🔀 NGINX — Reverse Proxy + Load Balancer + Small Form App&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="710" x="10" y="268" as="geometry" />
        </mxCell>
        <mxCell id="111" parent="100" style="text;html=1;strokeColor=#006EAF;fillColor=#1ba1e2;align=center;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;b&gt;Server Configuration:&lt;/b&gt;&lt;br&gt;• worker_processes auto&lt;br&gt;• worker_connections 1024&lt;br&gt;• sendfile on | tcp_nopush on | tcp_nodelay on&lt;br&gt;• keepalive_timeout 65&lt;br&gt;• server_tokens off (hide Nginx version)&lt;br&gt;&lt;br&gt;&lt;b&gt;TLS Security:&lt;/b&gt;&lt;br&gt;• Protocols: TLSv1.2 + TLSv1.3 only&lt;br&gt;• Ciphers: ECDHE-ECDSA-AES256-GCM-SHA384,&lt;br&gt;  ECDHE-RSA-CHACHA20-POLY1305, AES128-GCM...&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;• ssl_session_cache shared:SSL:10m&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18));&quot;&gt;• ssl_session_timeout 10m&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Security Headers:&lt;/b&gt;&lt;br&gt;• HSTS: max-age=31536000; includeSubDomains&lt;br&gt;• X-Frame-Options: SAMEORIGIN&lt;br&gt;• X-Content-Type-Options: nosniff&lt;br&gt;&lt;br&gt;&lt;b&gt;Redirect:&lt;/b&gt; HTTP :80 → HTTPS :443 (301)&lt;/div&gt;" vertex="1">
          <mxGeometry height="353" width="344" x="12" y="317" as="geometry" />
        </mxCell>
        <mxCell id="112" parent="100" style="text;html=1;strokeColor=#006EAF;fillColor=#1ba1e2;align=center;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#ffffff;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;h5 style=&quot;line-height: 170%;&quot;&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;Upstream Pools (Round-Robin LB):&lt;/b&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;upstream get_backend:&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;→ 127.0.0.1:3001&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;→ 127.0.0.1:3002&lt;/span&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;upstream modify_backend:&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;→ 127.0.0.1:6001&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;→ 127.0.0.1:6002&lt;/span&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;upstream frontend:&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;→ 127.0.0.1:5001&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;→ 127.0.0.1:5002&lt;/span&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;Location Routes (HTTPS :443):&lt;br&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• /get/    → get_backend&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• /modify/ → modify_backend&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• /        → frontend&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• /assets/ → frontend (static)&lt;/span&gt;&lt;font size=&quot;1&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;b style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;Proxy Settings (all routes):&lt;br&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• proxy_http_version 1.1&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• X-Real-IP + X-Forwarded-For headers&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• proxy_connect_timeout 5s&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• proxy_read_timeout 60s&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• client_max_body_size 10M&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 9px; background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); line-height: 170%;&quot;&gt;• Logs: pfe_access.log / pfe_error.log&lt;/span&gt;&lt;/h5&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="362" width="342" x="368" y="308" as="geometry" />
        </mxCell>
        <mxCell id="120" parent="100" style="text;html=1;strokeColor=none;fillColor=#003d99;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;rounded=1;" value="&lt;b&gt;📊 MONITORING STACK COMPARISON &amp;amp; SELECTION&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="710" x="5" y="677" as="geometry" />
        </mxCell>
        <mxCell id="121" parent="100" style="text;html=1;strokeColor=#999999;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#555555;" value="&lt;b&gt;Zabbix&lt;/b&gt;&lt;br&gt;• Traditional monitoring&lt;br&gt;• Agent-based collection&lt;br&gt;• Complex configuration&lt;br&gt;• Good SNMP support&lt;br&gt;• Older architecture&lt;br&gt;• Less cloud-native" vertex="1">
          <mxGeometry height="115" width="222" x="10" y="717" as="geometry" />
        </mxCell>
        <mxCell id="122" parent="100" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#1a4a00;fontStyle=1;" value="&lt;b&gt;✅ PLG Stack (SELECTED)&lt;/b&gt;&lt;br&gt;• Prometheus (metrics scraping)&lt;br&gt;• Loki (log aggregation)&lt;br&gt;• Grafana (dashboards &amp;amp; UI)&lt;br&gt;• Alertmanager (alert routing)&lt;br&gt;• node_exporter on each VM&lt;br&gt;• Cloud-native, lightweight" vertex="1">
          <mxGeometry height="115" width="226" x="242" y="717" as="geometry" />
        </mxCell>
        <mxCell id="123" parent="100" style="text;html=1;strokeColor=#999999;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;rounded=1;fontSize=10;fontColor=#555555;" value="&lt;b&gt;ELK Stack&lt;/b&gt;&lt;br&gt;• Elasticsearch (storage/search)&lt;br&gt;• Logstash (data pipeline)&lt;br&gt;• Kibana (visualization)&lt;br&gt;• Filebeat / agents&lt;br&gt;• Heavy resource usage&lt;br&gt;• Complex scaling" vertex="1">
          <mxGeometry height="115" width="232" x="478" y="717" as="geometry" />
        </mxCell>
        <mxCell id="124" parent="100" style="text;html=1;strokeColor=#006EAF;fillColor=#1ba1e2;align=center;verticalAlign=middle;fontStyle=2;fontSize=10;rounded=1;fontColor=#ffffff;" value="💡 Decision: PLG Stack chosen — lightweight, cloud-native, Prometheus-native alerting, integrates with AlterManager API" vertex="1">
          <mxGeometry height="28" width="710" y="847" as="geometry" />
        </mxCell>
