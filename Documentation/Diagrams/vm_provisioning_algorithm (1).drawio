<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36 Edg/146.0.0.0" version="29.6.6">
  <diagram name="VM Provisioning Algorithm" id="vm-provisioning-algo">
    <mxGraphModel dx="1591" dy="868" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" value="&lt;b&gt;VM Provisioning Algorithm&lt;/b&gt;&lt;br&gt;(Differential Evolution + Whale Optimization)" vertex="1">
          <mxGeometry height="40" width="500" x="450" y="20" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" value="Start" vertex="1">
          <mxGeometry height="50" width="120" x="620" y="80" as="geometry" />
        </mxCell>
        <mxCell id="step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Step 1:&lt;br&gt;Randomly sample&lt;br&gt;m PMs from n total PMs" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="160" as="geometry" />
        </mxCell>
        <mxCell id="step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Step 2:&lt;br&gt;Map m VMs to&lt;br&gt;the m sampled PMs" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="260" as="geometry" />
        </mxCell>
        <mxCell id="step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" value="Step 3:&lt;br&gt;Calculate total&lt;br&gt;fitness score" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="360" as="geometry" />
        </mxCell>
        <mxCell id="step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Step 4:&lt;br&gt;Remap k1 times,&lt;br&gt;keep best fitness mapping" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="460" as="geometry" />
        </mxCell>
        <mxCell id="loop1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" value="k1 iterations" vertex="1">
          <mxGeometry height="20" width="100" x="770" y="500" as="geometry" />
        </mxCell>
        <mxCell id="loop1_arrow" edge="1" parent="1" source="step4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" target="step3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="495" />
              <mxPoint x="850" y="395" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Step 5:&lt;br&gt;Take different sample&lt;br&gt;of m PMs" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="560" as="geometry" />
        </mxCell>
        <mxCell id="step6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Step 6:&lt;br&gt;Redo Steps 1, 2, 3, 4&lt;br&gt;with new sample" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="660" as="geometry" />
        </mxCell>
        <mxCell id="loop2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" value="k2 iterations" vertex="1">
          <mxGeometry height="20" width="100" x="790" y="575" as="geometry" />
        </mxCell>
        <mxCell id="loop2_arrow" edge="1" parent="1" source="step5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryDy=0;dashed=1;" target="step1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="595" />
              <mxPoint x="900" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="step7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Step 7:&lt;br&gt;Redo Steps 5, 6&lt;br&gt;k2 times (total)" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="760" as="geometry" />
        </mxCell>
        <mxCell id="step8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="Step 8:&lt;br&gt;Merge k2 mappings,&lt;br&gt;select best overall fitness" vertex="1">
          <mxGeometry height="70" width="200" x="580" y="860" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" value="End&lt;br&gt;(Optimal Mapping)" vertex="1">
          <mxGeometry height="70" width="130" x="620" y="960" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" style="endArrow=classic;html=1;" target="step1">
