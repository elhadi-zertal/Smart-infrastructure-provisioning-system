        <mxCell id="info" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;Algorithm Inspiration:&lt;/b&gt;&lt;br&gt;• Differential Evolution&lt;br&gt;• Whale Optimization Algorithm&lt;br&gt;&lt;br&gt;&lt;b&gt;Complexity:&lt;/b&gt; O(n) → O(n/k)" vertex="1">
          <mxGeometry height="120" width="200" x="50" y="160" as="geometry" />
        </mxCell>
        <mxCell id="vars" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;Variables:&lt;/b&gt;&lt;br&gt;• n = total PMs&lt;br&gt;• m = sample size&lt;br&gt;• k1 = remapping iterations&lt;br&gt;• k2 = sample iterations&lt;br&gt;• k = mini-clusters count" vertex="1">
          <mxGeometry height="130" width="200" x="50" y="320" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;" value="&lt;i&gt;Note: Mini-cluster approach&lt;br&gt;optimizes from O(n) to O(n/k)&lt;/i&gt;" vertex="1">
